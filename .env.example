# Copy to .env for local development. Never commit real credentials —
# model/provider secrets arrive via the project secrets store at runtime,
# never through this file.

EVORUNTIME_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evoruntime
EVORUNTIME_SERVICE_NAME=evoruntime-eval-plane

# Workload identity (evoruntime.security.identities). Unset/unknown defaults
# to the least-privileged role (candidate-runner) — fails closed, not open.
EVORUNTIME_WORKLOAD_ROLE=evaluator
EVORUNTIME_WORKLOAD_SUBJECT=local-dev

# Egress broker allowlist (evoruntime.security.egress): comma-separated
# hostnames. Empty/unset denies all outbound destinations.
EVORUNTIME_EGRESS_ALLOWLIST=

# Evaluator Ed25519 signing key, base64-encoded raw private key bytes
# (evoruntime.security.signing.encode_private_key). Real deployments source
# this from the project secrets store — never commit an actual key here.
EVORUNTIME_EVALUATOR_SIGNING_KEY=
